# =============================================
# COMPRESIÓN GZIP
# Reduce el tamaño de HTML, CSS, JS ~70% antes de enviarlo al browser
# =============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# =============================================
# CACHÉ DEL BROWSER (Expires)
# El browser guarda archivos localmente y no los vuelve a pedir
# =============================================
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: 1 hora (el contenido puede cambiar)
    ExpiresByType text/html                  "access plus 1 hour"

    # CSS y JS: 1 semana
    ExpiresByType text/css                   "access plus 1 week"
    ExpiresByType application/javascript     "access plus 1 week"
    ExpiresByType text/javascript            "access plus 1 week"

    # Imágenes: 1 año (raramente cambian)
    ExpiresByType image/jpeg                 "access plus 1 year"
    ExpiresByType image/jpg                  "access plus 1 year"
    ExpiresByType image/png                  "access plus 1 year"
    ExpiresByType image/gif                  "access plus 1 year"
    ExpiresByType image/webp                 "access plus 1 year"
    ExpiresByType image/svg+xml              "access plus 1 year"
    ExpiresByType image/x-icon               "access plus 1 year"

    # Fuentes: 1 año
    ExpiresByType font/ttf                   "access plus 1 year"
    ExpiresByType font/otf                   "access plus 1 year"
    ExpiresByType font/woff                  "access plus 1 year"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType application/font-woff      "access plus 1 year"
    ExpiresByType application/font-woff2     "access plus 1 year"

    # PDF: 1 mes
    ExpiresByType application/pdf            "access plus 1 month"

    # Video: 1 año
    ExpiresByType video/mp4                  "access plus 1 year"
    ExpiresByType video/webm                 "access plus 1 year"
</IfModule>

# =============================================
# CACHE-CONTROL HEADERS
# =============================================
<IfModule mod_headers.c>
    # Imágenes, fuentes y videos: caché larga
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # CSS y JS: 1 semana
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # HTML: revalidar cada hora
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # PDF: 1 mes
    <FilesMatch "\.pdf$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # -----------------------------------------------
    # SEGURIDAD: headers recomendados por Lighthouse
    # -----------------------------------------------

    # Evita que el browser adivine el tipo MIME
    Header always set X-Content-Type-Options "nosniff"

    # Solo permite embeber esta página en iframes del mismo origen
    Header always set X-Frame-Options "SAMEORIGIN"

    # Controla qué información de referencia se envía
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # HSTS: fuerza HTTPS por 1 año (actívalo solo si tienes SSL activo en HostGator)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # COOP: aísla el contexto de navegación para proteger contra ataques de ventana emergente
    # "same-origin-allow-popups" permite que Google Forms y redes sociales abran en popup
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Permissions Policy: desactiva APIs del browser que el sitio no usa
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # CSP: política de seguridad de contenido
    # Permite inline scripts/styles porque el sitio usa Tailwind CDN y Alpine.js inline
    # frame-src incluye youtube-nocookie.com (ya cambiado) y Google Forms
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://docs.google.com https://player.cloudinary.com; font-src 'self' data: https://cdnjs.cloudflare.com https://unpkg.com; connect-src 'self' https://res.cloudinary.com; media-src 'self' https://res.cloudinary.com blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://docs.google.com; upgrade-insecure-requests;"

    # CORS: permite cargar recursos de Cloudinary
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# =============================================
# KEEP-ALIVE
# Reutiliza la misma conexión TCP para múltiples recursos
# =============================================
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# =============================================
# CHARSET UTF-8 por defecto
# =============================================
AddDefaultCharset UTF-8
